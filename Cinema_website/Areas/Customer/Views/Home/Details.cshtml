@model Cinema_website.Models.Movie


<div class="container my-5">
    <div class="card shadow-lg border-0 rounded-4 overflow-hidden">
        <div class="row g-0">
            <!-- Movie Poster -->
            <div class="col-md-5 col-lg-4 position-relative">
                <img src="~/Images/Movies_Images/@Model.MainImg" class="img-fluid w-100 h-100 object-fit-cover" alt="@Model.Name" style="min-height: 400px;">
                @if (Model.Category != null)
                {
                    <span class="badge bg-primary position-absolute top-0 start-0 m-3 px-3 py-2 fs-6 rounded-pill shadow">
                        @Model.Category.Name
                    </span>
                }
            </div>

            <!-- Movie Details Content -->
            <div class="col-md-7 col-lg-8 p-4 p-md-5 d-flex flex-column justify-content-between bg-white">
                <div>
                    <div class="d-flex justify-content-between align-items-start mb-2">
                        <h1 class="fw-bold text-dark mb-0">@Model.Name</h1>
                        <span class="badge bg-warning text-dark fs-6 px-3 py-2">
                            <i class="bi bi-star-fill me-1"></i> $4.99
                        </span>
                    </div>

                    <!-- Cinema Info -->
                    @if (Model.Cinema != null)
                    {
                        <p class="text-muted mb-3 fs-6">
                            <i class="bi bi-geo-alt-fill text-danger me-1"></i>
                            <strong>Cinema:</strong> @Model.Cinema.Name
                        </p>
                    }

                    <hr class="my-3 text-muted">

                    <!-- Movie Dates & Status -->
                    <div class="row mb-4">
                        <div class="col-6 col-sm-4">
                            <small class="text-muted d-block">Release Date</small>
                            <span class="fw-semibold"><i class="bi bi-calendar-event me-1"></i>@Model.Date_Time.ToString("dd MMM yyyy")</span>
                        </div>
                        
                    </div>

                    <!-- Description -->
                    <h5 class="fw-bold text-dark mb-2">Overview</h5>
                    <p class="text-secondary lh-lg mb-4">
                        @Model.Description
                    </p>
                </div>

                <!-- Action & Booking Buttons -->
                <!-- Action & Booking Form -->
                <div class="pt-3 border-top d-flex flex-wrap gap-3 align-items-center justify-content-between">
                    <!-- Back Button -->
                    <a asp-area="Customer" asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary btn-lg px-4">
                        <i class="bi bi-arrow-left me-1"></i> Back to Movies
                    </a>

                    <!-- Booking Form with Quantity Input -->
                    <form asp-area="Customer" asp-controller="Cart" asp-action="AddToCart" class="d-flex align-items-center gap-2">
                        <input type="hidden" name="movieId" value="@Model.Id" />

                        <div class="input-group input-group-lg" style="width: 140px;">
                            <span class="input-group-text bg-light text-muted fw-bold">Qty</span>
                            <input type="number" name="count" class="form-control text-center fw-bold" value="1" min="1" max="10" required />
                        </div>

                        <button type="submit" class="btn btn-primary btn-lg px-4 fw-bold shadow-sm d-flex align-items-center gap-2">
                            <i class="bi bi-ticket-perforated-fill"></i>
                            <span>Book Ticket</span>
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>