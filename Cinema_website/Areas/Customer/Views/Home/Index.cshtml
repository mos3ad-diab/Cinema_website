@model IEnumerable<Cinema_website.Models.Movie>

@{
    ViewData["Title"] = "Home Page";
}

<!-- Hero Banner Header -->
<div class="bg-dark text-white text-center py-5 mb-5 rounded shadow-sm">
    <h1 class="display-4 fw-bold">Welcome to Falcon Cinema</h1>
    <p class="lead">Book your movie tickets easily and enjoy the best cinematic experience.</p>
</div>

<!-- Movies Grid -->
<div class="row row-cols-1 row-cols-md-3 row-cols-lg-4 g-4">
    @if (Model != null && Model.Any())
    {
        @foreach (var movie in Model)
        {
            <div class="col">
                <div class="card h-100 shadow-sm border-0 position-relative">
                    <!-- Category Badge -->
                    <span class="position-absolute top-0 start-0 bg-primary text-white px-3 py-1 rounded-end mt-2 fw-semibold fs-6">
                        @movie.Category?.Name
                    </span>

                    <!-- Movie Image -->
                    <img src="~/images/Movies_Images/@movie.MainImg" class="card-img-top" alt="@movie.Name" style="height: 350px; object-fit: cover;"
                         onerror="this.src='https://via.placeholder.com/300x450?text=No+Image';">

                    <div class="card-body d-flex flex-column">
                        <h5 class="card-title fw-bold text-dark">@movie.Name</h5>
                        <p class="card-text text-muted mb-2 fs-6">
                            <i class="bi bi-geo-alt-fill text-danger me-1"></i>@movie.Cinema?.Name
                        </p>
                        <p class="card-text fw-bold text-success fs-5 mb-3">
                            Price: $4
                        </p>

                        <!-- Action Buttons -->
                        <div class="mt-auto d-grid gap-2">
                            <a asp-area="Customer" asp-controller="Home" asp-action="Details" asp-route-id="@movie.Id" class="btn btn-outline-dark">
                                <i class="bi bi-eye me-1"></i> Details
                            </a>
                            <a asp-area="Customer" asp-controller="Cart" asp-action="AddToCart" asp-route-movieId="@movie.Id" class="btn btn-primary">
                                <i class="bi bi-ticket-perforated me-1"></i> Book Ticket
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        }
    }
    else
    {
        <div class="col-12 text-center py-5">
            <h3 class="text-muted">No movies available right now.</h3>
        </div>
    }
</div>