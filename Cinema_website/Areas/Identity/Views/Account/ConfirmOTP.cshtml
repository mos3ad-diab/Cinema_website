@model Cinema_website.ViewModels.ConfirmOTPVM

@{
    ViewData["Title"] = "Confirm OTP";
}

<div class="container">
    <h1>Verify OTP</h1>
    <h4>Enter otp to confirm the process</h4>
    <hr />
    <div class="row">
        <div class="col-md-4">
            <form asp-action="ConfirmOTP" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                <input asp-for="UserId" hidden/>
                <div class="form-group">
                    <label asp-for="OTP" class="control-label"></label>
                    <input asp-for="OTP" class="form-control" />
                    <span asp-validation-for="OTP" class="text-danger"></span>
                </div>

                <div class="form-group mt-4">
                    <input type="submit" value="submit" class="btn btn-primary" />
                </div>
            </form>
        </div>
    </div>

    <div class="mt-3">
        <a asp-action="Login">Back to Login</a>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}