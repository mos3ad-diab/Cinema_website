@{
    ViewData["Title"] = "Access Denied";
}

<div class="container text-center mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card border-danger shadow-sm">
                <div class="card-body p-5">
                    <div class="mb-4">
                        <i class="bi bi-shield-lock-fill text-danger" style="font-size: 4rem;"></i>
                    </div>
                    <h1 class="card-title text-danger fw-bold mb-3">Access Denied</h1>
                    <p class="card-text text-muted mb-4">
                        You do not have permission to view this resource or perform this action.
                    </p>
                    <div class="d-grid gap-2 d-sm-flex justify-content-sm-center">
                        <a asp-area="Admin" asp-controller="Cinema" asp-action="Index" class="btn btn-primary btn-lg px-4 gap-3">
                            Go to Home
                        </a>
                        <a asp-area="Identity" asp-controller="Account" asp-action="Login" class="btn btn-outline-secondary btn-lg px-4">
                            Switch Account
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>