@model Actor

@{
    ViewData["Title"] = "Edit Actor";
}

@section Styles {
    <link rel="stylesheet" href="~/css/admin/edit.css" asp-append-version="true" />
}

<div class="edit-container">
    <div class="card edit-card">
        <div class="card-header">
            <h2><i class="fa-solid fa-pen-to-square"></i> Edit Actor</h2>
            <a href="/Admin/Actor/Index" class="btn-back"><i class="fa-solid fa-arrow-left"></i> Back to List</a>
        </div>

        <form action="/Admin/Actor/Edit" method="post" enctype="multipart/form-data" class="edit-form">
            <input type="hidden" name="Id" value="@Model.Id" />

            <div class="form-group">
                <label for="Name" class="form-label">Actor Name</label>
                <input type="text" id="Name" name="Name" value="@Model.Name" class="form-control" required />
            </div>

            <div class="form-group">
                <label class="form-label">Current Photo</label>
                <div class="current-image-wrapper">
                    <img src="~/Images/Actors_Images/@Model.Img" alt="@Model.Name" asp-append-version="true" />
                </div>
            </div>

            <div class="form-group">
                <label for="img" class="form-label">Change Photo (Optional)</label>
                <input type="file" id="img" name="img" class="form-control" accept="image/*" />
            </div>

            <div class="form-actions">
                <button type="submit" class="btn-save"><i class="fa-solid fa-check"></i> Save Changes</button>
                <a href="/Admin/Actor/Index" class="btn-cancel">Cancel</a>
            </div>
        </form>
    </div>
</div>