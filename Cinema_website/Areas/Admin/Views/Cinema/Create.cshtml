@model Cinema

@{
    ViewData["Title"] = "Add Cinema";
}

@section Styles {
    <link rel="stylesheet" href="~/css/admin/edit.css" asp-append-version="true" />
}

<div class="edit-container">
    <div class="card edit-card">
        <div class="card-header">
            <h2><i class="fa-solid fa-plus"></i> Add New Cinema</h2>
            <a asp-area="Admin" asp-controller="Cinema" asp-action="Index" class="btn-back">
                <i class="fa-solid fa-arrow-left"></i> Back to List
            </a>
        </div>

        <form asp-area="Admin" asp-controller="Cinema" asp-action="Create" method="post" enctype="multipart/form-data" class="edit-form">
            <div class="form-group">
                <label asp-for="Name" class="form-label">Cinema Name</label>
                <input asp-for="Name" class="form-control" placeholder="Enter cinema name" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label for="img" class="form-label">Cinema Image</label>
                <input type="file" id="img" name="img" class="form-control" accept="image/*" />
                <span asp-validation-for="Img" class="text-danger"></span>
            </div>

            <div class="form-actions">
                <button type="submit" class="btn-save"><i class="fa-solid fa-check"></i> Save Cinema</button>
                <a asp-area="Admin" asp-controller="Cinema" asp-action="Index" class="btn-cancel">Cancel</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}