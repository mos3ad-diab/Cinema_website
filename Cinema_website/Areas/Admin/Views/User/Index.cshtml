@using Cinema_website.ViewModels
@model List<UserVM>

@{
    ViewData["Title"] = "Users Management";
}

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="fw-bold text-primary"><i class="fa-solid fa-users me-2"></i> Users Management</h2>
        <a asp-area="Identity" asp-controller="Account" asp-action="Register" class="btn btn-success fw-bold">
            <i class="fa-solid fa-user-plus me-1"></i> Add New User
        </a>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0 text-center">
                    <thead class="table-light">
                        <tr>
                            <th style="width: 5%;">#</th>
                            <th class="text-start ps-3">User Name</th>
                            <th>Email</th>
                            <th>Address</th>
                            <th>Phone</th>
                            <th>Status</th>
                            <th style="width: 20%;">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            int index = 1;
                            foreach (var item in Model)
                            {
                                <tr>
                                    <td>@index</td>
                                    <td class="text-start ps-3 fw-semibold">@item.Name</td>
                                    <td>@item.Email</td>
                                    <td>@(string.IsNullOrEmpty(item.Address) ? "N/A" : item.Address)</td>
                                    <td>@(string.IsNullOrEmpty(item.PhoneNumber) ? "N/A" : item.PhoneNumber)</td>
                                    <td>
                                        @if (item.LockOutEnd != null && item.LockOutEnd > DateTimeOffset.UtcNow)
                                        {
                                            <span class="badge bg-danger">Locked</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-success">Active</span>
                                        }
                                    </td>
                                    <td>
                                        @if (User.IsInRole("SuperAdmin"))
                                        {
                                            <div class="d-flex justify-content-center gap-2">
                                                <!-- Lock/Unlock Toggle -->
                                                @if (item.LockOutEnd != null && item.LockOutEnd > DateTimeOffset.UtcNow)
                                                {
                                                    <a asp-area="Admin" asp-controller="User" asp-action="Unlock" asp-route-id="@item.Id"
                                                       class="btn btn-sm btn-outline-success">
                                                        <i class="fa-solid fa-lock-open"></i> Unlock
                                                    </a>
                                                }
                                                else
                                                {
                                                    <a asp-area="Admin" asp-controller="User" asp-action="Lock" asp-route-id="@item.Id"
                                                       class="btn btn-sm btn-outline-warning">
                                                        <i class="fa-solid fa-lock"></i> Lock
                                                    </a>
                                                }

                                                <a asp-area="Admin" asp-controller="User" asp-action="Edit" asp-route-id="@item.Id"
                                                   class="btn btn-sm btn-outline-primary">
                                                    <i class="fa-solid fa-pen-to-square"></i> Edit
                                                </a>

                                                <form asp-area="Admin" asp-controller="User" asp-action="Delete" asp-route-id="@item.Id"
                                                      method="post" onsubmit="return confirm('Are you sure you want to delete this user?');">
                                                    <button type="submit" class="btn btn-sm btn-outline-danger">
                                                        <i class="fa-solid fa-trash"></i>
                                                    </button>
                                                </form>
                                            </div>
                                        }
                                        else
                                        {
                                            <span class="text-muted fst-italic">No Actions!!!</span>
                                        }
                                    </td>
                                </tr>
                                index++;
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="7" class="text-muted py-4">No Users found.</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>